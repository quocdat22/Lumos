    {
      "dot": "cyan",
      "title": "Presentation & Gateway",
      "items": [
        "Streamlit web interface on :8501 supports drag-and-drop e-book upload and real-time SSE chat rendering",
        "FastAPI gateway on :8000 exposes REST endpoints for ingestion, library health, and streaming responses",
        "Zero heavyweight framework overhead; implements pure Python orchestration without LangChain"
      ]
    },
    {
      "dot": "emerald",
      "title": "Core RAG & Storage",
      "items": [
        "Multi-format ingestion: pypdf for PDFs, ebooklib + BeautifulSoup4 with zip fallback for EPUBs",
        "Recursive text chunker splits chapters with 800-char window and 150-char overlap",
        "Embedded ChromaDB maintains HNSW cosine vector index in ./data/chroma_db with SQLite persistence"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & External Cloud AI",
      "items": [
        "API keys (OPENROUTER_API_KEY, JINA_API_KEY) remain strictly confined to the local host environment",
        "Jina Embeddings API computes task-specific dense vectors (retrieval.passage and retrieval.query)",
        "OpenRouter streams DeepSeek-V4-Flash responses with citation metadata and grounded provenance"
      ]
    }
